{
  "name": "amare-clinica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.5",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.0"
  },
  "reactSnap": {
    "source": "dist",
    "destinationDir": "dist",
    "include": [
      "/"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "puppeteerExecutablePath": "",
    "skipThirdPartyRequests": true,
    "inlineCss": false,
    "removeStyleTags": false,
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "crawl": false,
    "saveAs": "html",
    "fixInsecureRequests": false
  }
}
